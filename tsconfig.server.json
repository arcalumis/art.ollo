{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"isolatedModules": true,
		"moduleDetection": "force",
		"strict": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["server", "tests", "scripts/*.ts"]
}
