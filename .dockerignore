# Dependencies
node_modules

# Git
.git
.gitignore

# Environment files (secrets come from docker-compose env_file at runtime; build-time
# VITE_* values are passed as build args)
.env
.env.*
!.env.example

# Documentation
*.md
LICENSE

# IDE/Editor
.vscode
.idea
*.swp
*.swo

# Claude
.claude

# Development data (production uses volumes)
data/*.db
generated-images/*
uploads/*

# Build artifacts (rebuilt in container)
dist

# Not needed in the image
tests
shots
scripts/*.sh

# Misc
.DS_Store
Thumbs.db
*.log
